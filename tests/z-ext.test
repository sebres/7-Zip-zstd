# z-ext.test --
#
# Part of 7-zip ZS test suite.
# Test for enhancements of srv-mode version.
#
# Copyright (c) 2025- by Sergey G. Brester aka sebres

if {[namespace which -command "::7z"] eq ""} {
	source [file join [file dirname [info script]] 7z.tcl]
}

testConstraint openssl [expr {![catch {exec openssl version}]}]

test z-ext--direct-encryption {7z direct encryption, decription with openssl} -constraints {openssl} -body {
	variable Z7_PATH
	variable Z7_EKEY
	variable Z7_EKIV
	foreach {t l} {zstd 3 brotli 1} {
		# to test PKCS#7 padding is correct, we will use different length...
		set v "test zstd & brotli 0123456789-ABCEFGHIJKLMNOPQRSTUVWXYZ?_*."
		while {$v ne ""} {
			# compress with encryption, decrypt with openssl, decompress:
			if {[catch {
				#puts $t\tTL:[string length $v]\tC:[string length [7z_2_bin a -t$t -mx3 -si -so . << "$v"]]\tP:[string length [7z_2_bin a -t$t -mx3 -si -so -ekey$Z7_EKEY$Z7_EKIV . << "$v"]]
				set v2 [
					7z a -t$t -mx$l -si -so -ekey$Z7_EKEY$Z7_EKIV . << "$v" | \
					openssl enc -aes-256-cbc -nosalt -K "$Z7_EKEY" -iv "$Z7_EKIV" -d | \
					$Z7_PATH e -t$t -si -so
				]
				if {$v2 ne $v} {
					error "retrieved \"$v2\" instead of original"
				}
			} res]} {
				error "Test of -t$t on \"$v\" failed: $res"
			}
			set v [string range $v 0 end-[expr {$t eq "zstd" ? 4 : 12}]]
		}
	}
	set _ OK
} -result OK

test z-ext--direct-encrypt-decrypt {7z direct encryption, decription} {
	variable Z7_PATH
	variable Z7_EKEY
	variable Z7_EKIV
	foreach {t l} {zstd 9 brotli 5} {
		# to test PKCS#7 padding is correct, we will use different length...
		set v "test zstd & brotli 0123456789-ABCEFGHIJKLMNOPQRSTUVWXYZ?_*."
		while {$v ne ""} {
			# compress with encryption, decompress with decryption:
			if {[catch {
				#puts $t\tTL:[string length $v]\tC:[string length [7z_2_bin a -t$t -mx$l -si -so . << "$v"]]\tP:[string length [7z_2_bin a -t$t -mx$l -si -so -ekey$Z7_EKEY$Z7_EKIV . << "$v"]]
				set v2 [
					7z a -t$t -mx$l -si -so -ekey$Z7_EKEY$Z7_EKIV . << "$v" | \
					$Z7_PATH e -t$t -si -so -ekey$Z7_EKEY$Z7_EKIV
				]
				#puts $v2
				if {$v2 ne $v} {
					error "retrieved \"$v2\" instead of original"
				}
			} res]} {
				error "Test of -t$t on \"$v\" failed: $res"
			}
			set v [string range $v 0 end-[expr {$t eq "zstd" ? 4 : 12}]]
		}
	}
	set _ OK
} OK

test z-ext--decompress-w-offs-length {7z fast decompression of chunk by offset/length} {
	variable Z7_REGR_TEST_DIR
	set ret {}
	# 4 test files, compressed 1M chars, starting with TEST\n and ending with \nEND. and 1M-10 spaces in-between.
	foreach p [lsort -dictionary [glob -directory $Z7_REGR_TEST_DIR test.txt.*]] {
		if {![regexp {\.txt\.(?:br|zstd)(?:\.7z)?$} $p]} continue
		lappend ret [file tail $p]
		if {[catch {
			lappend ret [7z e -eoffs=0:4 -so -- $p] [7z e -eoffs=999996:4 -so -- $p]
			lappend ret [7z e -eoffs=2:8 -so -- $p] [7z e -eoffs=999990:8 -so -- $p]
		} res opt]} {
			dict set opt -errorinfo "unexpected error by decompress \"[file tail $p]\": [dict get $opt -errorinfo]"
			return {*}$opt "unexpected error by decompress \"[file tail $p]\": $res"
		}
	}
	set ret
} [list {*}{
	test.txt.br      TEST END. "ST\n     " "     \nEN"
	test.txt.br.7z   TEST END. "ST\n     " "     \nEN"
	test.txt.zstd    TEST END. "ST\n     " "     \nEN"
	test.txt.zstd.7z TEST END. "ST\n     " "     \nEN"
}]

test z-ext--decompress-encr-file-w-offs-length {7z fast decompression of encrypted chunk from file by offset/length} {
	variable Z7_REGR_TEST_DIR
	variable Z7_EKEY
	variable Z7_EKIV
	set ret {}
	foreach {p} [lsort -dictionary [glob -directory $Z7_REGR_TEST_DIR xenc-ekey.*]] {
		# decompress part of file by offset:length with decryption:
		lappend ret [file tail $p]
		lappend ret [7z e -ekey$Z7_EKEY$Z7_EKIV -eoffs=0:4 -so -- $p] [7z e -ekey$Z7_EKEY$Z7_EKIV -eoffs=999996:4 -so -- $p]
		lappend ret [7z e -ekey$Z7_EKEY$Z7_EKIV -eoffs=2:8 -so -- $p] [7z e -ekey$Z7_EKEY$Z7_EKIV -eoffs=999990:8 -so -- $p]
	}
	set ret
} [list {*}{
	xenc-ekey.br      TEST END. "ST\n     " "     \nEN"
	xenc-ekey.zstd    TEST END. "ST\n     " "     \nEN"
}]

test z-ext--decompress-encr-pipe-w-offs-length {7z fast decompression of encrypted chunk from pipe by offset/length} {
	variable Z7_PATH
	variable Z7_EKEY
	variable Z7_EKIV
	set v "test zstd & brotli 0123456789-ABCEFGHIJKLMNOPQRSTUVWXYZ?_*."
	set v "1. $v; 2. $v; 3. $v;"
	set o [expr {[string length $v] / 3 + 1}]; set l [expr {$o-2}]; # offset:length for interim part from 2. to semicolon
	foreach {t l} {zstd 9 brotli 5} {
		# compress with encryption, decompress part of pipe stream by offset:length with decryption:
		if {[catch {
			set v2 [
				7z a -t$t -mx$l -si -so -ekey$Z7_EKEY$Z7_EKIV . << "$v" | \
				$Z7_PATH e -t$t -si -so -ekey$Z7_EKEY$Z7_EKIV -eoffs=$o:$l
			]
			#puts $v2
			if {$v2 ne [set v3 [string range $v $o [expr {$o+$l-1}]]]} {
				error "retrieved \"$v2\" instead of original part \"$v3\""
			}
		} res]} {
			error "Test of -t$t on \"$v\" failed:\n$res"
		}
	}
	set _ OK
} OK

::tcltest::cleanupTests
